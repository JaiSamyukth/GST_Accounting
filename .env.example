# Neon Postgres pooled connection string (runtime).
# Neon dashboard -> Connection Details -> Pooled connection.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection string, used only by drizzle-kit push/generate.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Neon Object Storage (S3-compatible). Generate the key pair in the Neon console.
AWS_ENDPOINT_URL_S3="https://<branch-id>.storage.c-1.<region>.aws.neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"
S3_BUCKET="gst-documents"

# Set to "true" behind HTTPS (Vercel). Leave false on localhost.
COOKIE_SECURE="false"

# Session lifetime in hours.
SESSION_HOURS="12"

# Public URL, used in password reset links.
APP_URL="http://localhost:3000"
