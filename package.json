{
  "name": "gst-invoice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx src/db/seed-cli.ts",
    "user:reset-link": "node --env-file-if-exists=.env.local --import tsx src/db/reset-link-cli.ts",
    "backup:restore": "node --env-file-if-exists=.env.local --import tsx src/db/restore-cli.ts",
    "vercel-build": "node --import tsx src/db/migrate.ts && next build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.11.0",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "https-proxy-agent": "^9.1.0",
    "next": "^16.4.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
